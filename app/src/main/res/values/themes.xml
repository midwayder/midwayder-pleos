<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- DayNight: 시스템(Pleos) 야간 모드를 따라 values-night 색으로 바뀐다. 앱 안에 따로 전환 버튼을 두지 않는다. -->
    <style name="Theme.MidWayDerPleos" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/background</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorHint">@color/text_muted</item>
    </style>

    <!-- 마이크: 옅은 강조색 원 + 강조색 선 아이콘 -->
    <style name="Widget.MidWayDerPleos.Mic" parent="Widget.AppCompat.ImageButton">
        <item name="android:background">@drawable/bg_mic_round</item>
        <item name="android:tint">@color/accent</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:padding">0dp</item>
    </style>

    <!-- 내비로 보내기: Pleos 내비 "안내 종료" 카드처럼 검정(다크는 흰) 버튼 -->
    <style name="Widget.MidWayDerPleos.Primary" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/bg_primary</item>
        <item name="android:textColor">@color/on_button_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- 처음부터: 아이콘 + 글자, 터치 영역 56dp -->
    <style name="Widget.MidWayDerPleos.TextAction" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:minWidth">56dp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:drawableTint">@color/text_secondary</item>
    </style>
</resources>
