<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- 말하기 화면: 목적지 / 경유지. 질문 한 줄, 마이크, 인식된 말. -->
    <LinearLayout
        android:id="@+id/promptView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="32dp">

        <TextView
            android:id="@+id/prompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text"
            android:textSize="36sp"
            android:textStyle="bold"
            android:gravity="center" />

        <Button
            android:id="@+id/mic"
            style="@style/Widget.MidWayDerPleos.MicRound"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginTop="22dp"
            android:text="🎤"
            android:contentDescription="@string/mic" />

        <TextView
            android:id="@+id/transcript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:textColor="@color/accent"
            android:textSize="24sp"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- 목적지 후보 목록 -->
    <LinearLayout
        android:id="@+id/listView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="70dp"
        android:paddingTop="12dp"
        android:paddingBottom="18dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/listTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:textSize="22sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <Button
                android:id="@+id/listMic"
                style="@style/Widget.MidWayDerPleos.MicRound"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:text="🎤"
                android:textSize="18sp"
                android:contentDescription="@string/mic" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:paddingBottom="4dp"
            android:scrollbars="vertical" />
    </LinearLayout>

    <!-- 지도 화면: 왼쪽 순위 목록, 오른쪽 지도 -->
    <LinearLayout
        android:id="@+id/mapScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:visibility="gone">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/stops"
            android:layout_width="0dp"
            android:layout_weight="0.36"
            android:layout_height="match_parent"
            android:paddingStart="14dp"
            android:paddingEnd="8dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:clipToPadding="false"
            android:scrollbars="vertical" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_weight="0.64"
            android:layout_height="match_parent">

            <org.osmdroid.views.MapView
                android:id="@+id/map"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- OpenStreetMap 타일 라이선스(ODbL)상 출처 표기는 지울 수 없어 최소 크기로 둔다. -->
            <TextView
                android:id="@+id/mapNote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="2dp"
                android:alpha="0.55"
                android:text="@string/map_note"
                android:textColor="@color/text_muted"
                android:textSize="8sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp"
                android:paddingTop="8dp"
                android:paddingBottom="22dp">

                <Button
                    android:id="@+id/mapMic"
                    style="@style/Widget.MidWayDerPleos.MicRound"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="🎤"
                    android:textSize="18sp"
                    android:contentDescription="@string/mic" />

                <Button
                    android:id="@+id/insert"
                    style="@style/Widget.MidWayDerPleos.Primary"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- 처음부터: 모든 화면 우상단 아이콘. 목적지 단계에서는 숨긴다. -->
    <Button
        android:id="@+id/restartIcon"
        style="@style/Widget.MidWayDerPleos.IconRound"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="top|end"
        android:layout_margin="10dp"
        android:text="↺"
        android:contentDescription="@string/restart"
        android:visibility="gone" />
</FrameLayout>
